# Traffic AI System Configuration
PROJECT_NAME="AI-Based Traffic Management System"
VERSION="1.0.0"
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL="sqlite:///./traffic_system.db"

# Storage paths
UPLOAD_DIR="./storage/uploads"
PROCESSED_DIR="./storage/processed"
REPORTS_DIR="./storage/reports"
MODELS_DIR="./models"

# AI Model settings
DEFAULT_MODEL_PATH="./models/yolov8n.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
TRACKER_TYPE="bytetrack"

# Congestion Thresholds (occupancy percentage or vehicle count per 100m)
LOW_CONGESTION_MAX=5
MEDIUM_CONGESTION_MAX=15

# Signal optimization limits (seconds)
MIN_GREEN_TIME=10
MAX_GREEN_TIME=60
AMBER_CLEARANCE_TIME=4
ALL_RED_CLEARANCE_TIME=2
DEFAULT_CYCLE_TIME=120
